<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) backup / transfer rules.

    The auth token lives in an AES-256 EncryptedSharedPreferences file
    (cashbook_secure_prefs) whose key is held in the Android Keystore. Neither
    the Keystore key nor its keyset travels in a backup or a device transfer, so
    a restored copy can never be decrypted - the app would fail the first time it
    read the token on the new device. Exclude that one file and let the user sign
    in again; every other preference is plain and restores fine.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cashbook_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cashbook_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
