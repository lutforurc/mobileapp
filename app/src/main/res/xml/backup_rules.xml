<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below (API 30-) full-backup rules - the counterpart of
    data_extraction_rules.xml for older devices. See that file for why the
    keystore-encrypted token store must not be backed up: it cannot be
    decrypted after a restore, so the user is asked to sign in again instead.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cashbook_secure_prefs.xml" />
</full-backup-content>
